<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moup.domain.alarm.mapper.AlarmRepository">

    <insert id="saveAnnouncementMappingForAllUsers">
        INSERT INTO admin_alarm_user_mappings (alarm_id, user_id)
        VALUES
        <foreach collection="users" item="user" separator=",">
            (#{announcementId}, #{user.id})
        </foreach>
        <!-- admin_alarm_user_mappings의 UNIQUE (alarm_id, user_id)와 짝이다.
             공지 발송이 재시도되어도 중복 행을 만들지 않고 조용히 넘어간다. -->
        ON DUPLICATE KEY UPDATE alarm_id = VALUES(alarm_id)
    </insert>

</mapper>
